# Random 32+ character secret; use the SAME secret in the Next.js .env.
LOCAL_FACE_SERVICE_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Licensed weights must be provisioned offline. No runtime download.
LOCAL_FACE_MODEL_ROOT=/opt/sahand/models
LOCAL_FACE_MODEL_NAME=buffalo_l
LOCAL_FACE_MATCH_THRESHOLD=0.75
